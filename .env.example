# Copy to .env.local and fill in. Used by the Contact Us form to send enquiries through Gmail SMTP.

# Main Gmail account that signs in to SMTP.
GMAIL_USER=your-account@gmail.com

# A 16-character Google App Password for GMAIL_USER, not your normal Gmail password.
# Requires 2-Step Verification on the account: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=

# Address the emails are sent from, e.g. an alias like info@yourdomain.com.
# It must be added to GMAIL_USER under Gmail Settings → Accounts → "Send mail as",
# otherwise Gmail replaces it with GMAIL_USER. Defaults to GMAIL_USER.
MAIL_FROM=

# Optional: inbox that receives enquiries. Defaults to GMAIL_USER.
CONTACT_TO_EMAIL=
